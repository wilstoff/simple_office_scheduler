@using NodaTime
@using SimpleOfficeScheduler.Services
@using SimpleOfficeScheduler.Services.Users
@inject IUserSearchService UserSearchService
@using SimpleOfficeScheduler.Services.Rooms
@inject IRoomService RoomService
@inject IEventService EventService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<SimpleOfficeScheduler.Data.AppDbContext> DbFactory
@inject NodaTime.IClock Clock
@rendermode InteractiveServer

<div class="side-panel-overlay @(IsVisible ? "show" : "")" @onclick="Close"
     style="position:fixed;inset:0;z-index:1040;"></div>
<div class="side-panel @(IsVisible ? "show" : "")"
     style="position:fixed;top:0;width:560px;height:100vh;z-index:1050;right:@(IsVisible ? "0" : "-580px");transition:right 0.3s ease;overflow-y:auto;">
    <div class="side-panel-header">
        <h5>@(EventId.HasValue ? "Edit Event" : "New Event")</h5>
        <button class="btn-panel-close" @onclick="Close">&times;</button>
    </div>
    <div class="side-panel-body">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger py-2 small">@_errorMessage</div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Title</label>
                <InputText class="form-control" @bind-Value="_model.Title" placeholder="Event title" />
                <ValidationMessage For="() => _model.Title" />
            </div>

            <div class="mb-3">
                <label class="form-label">Event Type</label>
                <InputSelect class="form-select" @bind-Value="_model.EventType" disabled="@EventId.HasValue">
                    <option value="@EventType.OfficeHours">Office Hours</option>
                    <option value="@EventType.TechMeeting">Tech Meeting</option>
                    <option value="@EventType.Workshop">Workshop</option>
                </InputSelect>
                @if (_model.EventType == EventType.TechMeeting)
                {
                    <small class="text-muted">Capacity applies to lightning talks sessions only.</small>
                }
                else if (_model.EventType == EventType.Workshop)
                {
                    <small class="text-muted">The meeting is created up front for the owning team. Capacity limits sign-ups only.</small>
                }
            </div>

            @if (_model.EventType == EventType.Workshop)
            {
                <div class="mb-3">
                    <label class="form-label">Owning team</label>
                    <div class="d-flex gap-1">
                        <UserTypeahead SelectedUser="@_coOwnerToAdd"
                                       SelectedUserChanged="@(u => _coOwnerToAdd = u)"
                                       Placeholder="Add a co-owner..." />
                        <button type="button" class="btn btn-outline-primary"
                                disabled="@(_coOwnerToAdd is null)"
                                @onclick="AddCoOwner">Add</button>
                    </div>
                    @if (_model.CoOwners.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            @foreach (var co in _model.CoOwners)
                            {
                                <span class="badge bg-secondary d-flex align-items-center gap-1">
                                    @co.DisplayName
                                    <button type="button" class="btn-close btn-close-white"
                                            style="font-size:0.55rem;"
                                            @onclick="() => _model.CoOwners.Remove(co)"></button>
                                </span>
                            }
                        </div>
                    }
                    <small class="text-muted d-block mt-1">
                        Co-owners can edit the workshop and are on every occurrence's meeting.
                    </small>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Description</label>
                <InputTextArea class="form-control" rows="2" @bind-Value="_model.Description" placeholder="Optional description" />
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label class="form-label">Start</label>
                    <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_model.StartTime" />
                </div>
                <div class="col-6 mb-3">
                    <label class="form-label">End</label>
                    <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_model.EndTime" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Timezone</label>
                <InputSelect class="form-select" @bind-Value="_model.TimeZoneId">
                    @foreach (var tz in _timeZones)
                    {
                        <option value="@tz.Id">@tz.DisplayName</option>
                    }
                </InputSelect>
                <button type="button" class="btn btn-link btn-sm p-0 mt-1" style="font-size:0.8rem;" @onclick="ToggleAllTimeZones">
                    @(_showAllTimeZones ? "Show fewer timezones" : "Show all timezones")
                </button>
            </div>


            <div class="mb-3">
                <label class="form-label">Room</label>
                <div class="d-flex gap-1">
                    <InputSelect class="form-select" @bind-Value="_model.RoomEmail">
                        <option value="">No room</option>
                        @foreach (var room in _rooms)
                        {
                            <option value="@room.Email">@RoomLabel(room)</option>
                        }
                    </InputSelect>
                    <button type="button" class="btn btn-outline-secondary text-nowrap"
                            disabled="@_checkingAvailability"
                            @onclick="CheckRoomAvailability">
                        @(_checkingAvailability ? "Checking..." : "Check free/busy")
                    </button>
                </div>
                @if (_rooms.Count == 0)
                {
                    <small class="text-muted">No rooms are configured.</small>
                }
                else if (_availabilityUnavailable)
                {
                    <small class="text-muted">
                        Free/busy is not available for these rooms. Booking still works; the room
                        confirms or declines after the event is saved.
                    </small>
                }
                else if (_roomBusy.Count > 0)
                {
                    <small class="text-muted">
                        Free/busy shown for @_availabilityStart.ToString("MMM dd h:mm tt", null)
                        to @_availabilityEnd.ToString("h:mm tt", null).
                    </small>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Capacity</label>
                <InputNumber class="form-control" @bind-Value="_model.Capacity" min="1" />
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <InputCheckbox id="panelIsRecurring" class="form-check-input" @bind-Value="_model.IsRecurring" />
                    <label class="form-check-label" for="panelIsRecurring">Recurring event</label>
                </div>
            </div>

            @if (_model.IsRecurring)
            {
                <div class="card mb-3">
                    <div class="card-body py-2 px-3">
                        <div class="mb-2">
                            <label class="form-label">Frequency</label>
                            <InputSelect class="form-select form-select-sm" @bind-Value="_model.RecurrenceType">
                                <option value="@RecurrenceType.Daily">Daily</option>
                                <option value="@RecurrenceType.Weekly">Weekly</option>
                                <option value="@RecurrenceType.BiWeekly">Bi-Weekly</option>
                                <option value="@RecurrenceType.Monthly">Monthly</option>
                            </InputSelect>
                        </div>

                        <div class="mb-2">
                            <label class="form-label">Every</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_model.Interval" min="1" />
                        </div>

                        @if (_model.RecurrenceType is RecurrenceType.Weekly or RecurrenceType.BiWeekly)
                        {
                            <div class="mb-2">
                                <label class="form-label">Days</label>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var day in Enum.GetValues<DayOfWeek>())
                                    {
                                        var isChecked = _model.DaysOfWeek.Contains(day);
                                        <div class="form-check form-check-inline">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@isChecked"
                                                   @onchange="e => ToggleDay(day, (bool)e.Value!)" />
                                            <label class="form-check-label small">@day.ToString()[..3]</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="mb-2">
                            <label class="form-label">End date (optional)</label>
                            <InputDate class="form-control form-control-sm" @bind-Value="_model.RecurrenceEndDate" />
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    @(EventId.HasValue ? "Update" : "Create")
                </button>
                <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public DateTime? PrefilledStart { get; set; }
    [Parameter] public DateTime? PrefilledEnd { get; set; }
    [Parameter] public int? EventId { get; set; }
    [Parameter] public EventCallback OnEventSaved { get; set; }

    private EventFormModel _model = new();
    private string? _errorMessage;
    private bool _isSubmitting;
    private List<(string Id, string DisplayName)> _timeZones = new();
    private bool _showAllTimeZones;
    private bool _lastVisible;

    protected override void OnInitialized()
    {
        _timeZones = TimeZoneHelper.GetCommonTimeZones();
    }

    private void ToggleAllTimeZones()
    {
        _showAllTimeZones = !_showAllTimeZones;
        var currentId = _model.TimeZoneId;
        _timeZones = _showAllTimeZones
            ? TimeZoneHelper.GetAllTimeZones()
            : TimeZoneHelper.GetCommonTimeZones();

        // If the current selection isn't in the new list, keep it visible by adding it
        if (!string.IsNullOrEmpty(currentId) && !_timeZones.Any(tz => tz.Id == currentId))
        {
            var allZones = TimeZoneHelper.GetAllTimeZones();
            var match = allZones.FirstOrDefault(tz => tz.Id == currentId);
            if (match != default)
            {
                _timeZones.Insert(0, match);
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // When panel becomes visible, initialize form
        if (IsVisible && !_lastVisible)
        {
            _errorMessage = null;
            _rooms = (await RoomService.GetRoomsAsync()).ToList();
            _roomBusy.Clear();
            _availabilityUnavailable = false;

            if (EventId.HasValue)
            {
                var evt = await EventService.GetEventAsync(EventId.Value);
                if (evt is not null)
                {
                    _model = new EventFormModel
                    {
                        Title = evt.Title,
                        Description = evt.Description,
                        StartTime = evt.StartTime.ToDateTimeUnspecified(),
                        EndTime = evt.EndTime.ToDateTimeUnspecified(),
                        Capacity = evt.Capacity,
                        TimeZoneId = evt.TimeZoneId,
                        EventType = evt.EventType,
                        RoomEmail = evt.RoomEmail,
                        CoOwners = evt.CoOwners
                            .Select(o => new CoOwnerChoice(o.UserId, o.User?.DisplayName ?? ""))
                            .ToList(),
                        IsRecurring = evt.Recurrence is not null,
                        RecurrenceType = evt.Recurrence?.Type ?? RecurrenceType.Weekly,
                        Interval = evt.Recurrence?.Interval ?? 1,
                        DaysOfWeek = evt.Recurrence?.DaysOfWeek ?? new List<DayOfWeek>(),
                        RecurrenceEndDate = evt.Recurrence?.RecurrenceEndDate?.ToDateTimeUnspecified()
                    };
                }
            }
            else
            {
                // Timezone cascade: DB preference > browser > server
                string? userTzPref = null;
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var uidClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
                if (uidClaim is not null && int.TryParse(uidClaim.Value, out var uid))
                {
                    await using var db = await DbFactory.CreateDbContextAsync();
                    var user = await db.Users.FindAsync(uid);
                    userTzPref = user?.TimeZonePreference;
                }

                string resolvedTz;
                if (!string.IsNullOrEmpty(userTzPref) && TimeZoneHelper.IsValidTimeZoneId(userTzPref))
                {
                    resolvedTz = userTzPref;
                }
                else
                {
                    try
                    {
                        var browserTz = await JS.InvokeAsync<string>("eval",
                            "Intl.DateTimeFormat().resolvedOptions().timeZone");
                        resolvedTz = TimeZoneHelper.ResolveTimeZoneId(browserTz);
                    }
                    catch
                    {
                        resolvedTz = TimeZoneHelper.GetLocalTimeZoneId();
                    }
                }

                var now = Clock.GetCurrentInstant();
                var (defaultStart, defaultEnd) = TimeZoneHelper.GetDefaultEventTimes(resolvedTz, now);
                _model = new EventFormModel
                {
                    StartTime = PrefilledStart ?? defaultStart,
                    EndTime = PrefilledEnd ?? defaultEnd,
                    TimeZoneId = resolvedTz
                };

                // Ensure the timezone appears in the dropdown even if not in the common list
                if (!_timeZones.Any(tz => tz.Id == resolvedTz))
                {
                    var allZones = TimeZoneHelper.GetAllTimeZones();
                    var match = allZones.FirstOrDefault(tz => tz.Id == resolvedTz);
                    if (match != default)
                    {
                        _timeZones.Insert(0, match);
                    }
                }
            }
        }
        _lastVisible = IsVisible;
    }

    private void ToggleDay(DayOfWeek day, bool isChecked)
    {
        if (isChecked && !_model.DaysOfWeek.Contains(day))
            _model.DaysOfWeek.Add(day);
        else if (!isChecked)
            _model.DaysOfWeek.Remove(day);
    }

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _errorMessage = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim is null || !int.TryParse(userIdClaim.Value, out var userId))
        {
            _errorMessage = "Could not determine current user.";
            _isSubmitting = false;
            return;
        }

        if (_model.EndTime <= _model.StartTime)
        {
            _errorMessage = "End time must be after start time.";
            _isSubmitting = false;
            return;
        }

        var evt = new Event
        {
            Title = _model.Title,
            Description = _model.Description,
            StartTime = LocalDateTime.FromDateTime(_model.StartTime),
            EndTime = LocalDateTime.FromDateTime(_model.EndTime),
            Capacity = _model.Capacity,
            TimeZoneId = _model.TimeZoneId,
            EventType = _model.EventType
        };

        if (_model.IsRecurring)
        {
            evt.Recurrence = new RecurrencePattern
            {
                Type = _model.RecurrenceType,
                Interval = _model.Interval,
                DaysOfWeek = _model.DaysOfWeek,
                RecurrenceEndDate = _model.RecurrenceEndDate.HasValue
                    ? LocalDate.FromDateTime(_model.RecurrenceEndDate.Value)
                    : null
            };
        }

        try
        {
            if (EventId.HasValue)
            {
                evt.Id = EventId.Value;
                var (success, error) = await EventService.UpdateEventAsync(evt, userId);
                if (!success)
                {
                    _errorMessage = error;
                    _isSubmitting = false;
                    return;
                }

                // UpdateEventAsync deliberately leaves the room alone, so apply it separately.
                var (roomOk, roomError) = await EventService.SetRoomAsync(
                    EventId.Value, userId, _model.RoomEmail);
                if (!roomOk)
                {
                    _errorMessage = roomError;
                    _isSubmitting = false;
                    return;
                }

                var (coOwnerOk, coOwnerError) = await EventService.SetCoOwnersAsync(
                    EventId.Value, userId, _model.CoOwners.Select(c => c.UserId).ToList());
                if (!coOwnerOk)
                {
                    _errorMessage = coOwnerError;
                    _isSubmitting = false;
                    return;
                }
            }
            else
            {
                await EventService.CreateEventAsync(evt, userId,
                    _model.CoOwners.Select(c => c.UserId).ToList());
            }

            await OnEventSaved.InvokeAsync();
            await Close();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }

        _isSubmitting = false;
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private List<SimpleOfficeScheduler.Models.Room> _rooms = new();
    private readonly Dictionary<string, bool> _roomBusy = new(StringComparer.OrdinalIgnoreCase);
    private bool _availabilityUnavailable;
    private bool _checkingAvailability;
    private DateTime _availabilityStart;
    private DateTime _availabilityEnd;

    private string RoomLabel(SimpleOfficeScheduler.Models.Room room)
    {
        var parts = new List<string> { room.DisplayName };
        if (room.Capacity is int cap) parts.Add($"seats {cap}");
        if (!string.IsNullOrWhiteSpace(room.Building)) parts.Add(room.Building!);

        // Capacity is informational: the owning team is on the meeting on top of any sign-ups.
        var label = string.Join(" · ", parts);
        if (_roomBusy.TryGetValue(room.Email, out var busy))
            label += busy ? "  (busy)" : "  (free)";
        return label;
    }

    private async Task CheckRoomAvailability()
    {
        if (_rooms.Count == 0) return;

        _checkingAvailability = true;
        _availabilityUnavailable = false;
        _roomBusy.Clear();
        _availabilityStart = _model.StartTime;
        _availabilityEnd = _model.EndTime;

        try
        {
            var availability = await RoomService.GetAvailabilityAsync(
                _rooms.Select(r => r.Email).ToList(),
                LocalDateTime.FromDateTime(_model.StartTime),
                LocalDateTime.FromDateTime(_model.EndTime),
                _model.TimeZoneId);

            // Null means the data could not be read, which is not the same as every room being free.
            if (availability is null)
            {
                _availabilityUnavailable = true;
            }
            else
            {
                foreach (var a in availability)
                    _roomBusy[a.Email] = a.IsBusy;
            }
        }
        catch
        {
            _availabilityUnavailable = true;
        }
        finally
        {
            _checkingAvailability = false;
        }
    }

    private record CoOwnerChoice(int UserId, string DisplayName);

    private SimpleOfficeScheduler.Services.Users.UserSearchResult? _coOwnerToAdd;

    private async Task AddCoOwner()
    {
        var selection = _coOwnerToAdd;
        if (selection is null) return;

        var userId = selection.Id;
        if (selection.IsAdOnly)
        {
            // AD-only results have no local row yet, and ownership needs a real user id.
            var ensured = await UserSearchService.EnsureUserAsync(selection.Username);
            if (ensured is null)
            {
                _errorMessage = "Could not create a local account for the selected AD user.";
                return;
            }
            userId = ensured.Id;
        }

        if (!_model.CoOwners.Any(c => c.UserId == userId))
            _model.CoOwners.Add(new CoOwnerChoice(userId, selection.DisplayName));

        _coOwnerToAdd = null;
    }

    private class EventFormModel
    {
        [Required]
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public DateTime StartTime { get; set; }
        public DateTime EndTime { get; set; }
        public int Capacity { get; set; } = 1;
        public string TimeZoneId { get; set; } = string.Empty;
        public EventType EventType { get; set; } = EventType.OfficeHours;
        public List<CoOwnerChoice> CoOwners { get; set; } = new();
        public string? RoomEmail { get; set; }
        public bool IsRecurring { get; set; }
        public RecurrenceType RecurrenceType { get; set; } = RecurrenceType.Weekly;
        public int Interval { get; set; } = 1;
        public List<DayOfWeek> DaysOfWeek { get; set; } = new();
        public DateTime? RecurrenceEndDate { get; set; }
    }
}
