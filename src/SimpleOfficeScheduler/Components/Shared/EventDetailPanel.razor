@using NodaTime
@inject IEventService EventService
@inject IUserSearchService UserSearchService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="side-panel-overlay @(IsVisible ? "show" : "")" @onclick="Close"
     style="position:fixed;inset:0;z-index:1040;"></div>
<div class="side-panel @(IsVisible ? "show" : "")"
     style="position:fixed;top:0;width:560px;height:100vh;z-index:1050;right:@(IsVisible ? "0" : "-580px");transition:right 0.3s ease;overflow-y:auto;">
    @if (_event is not null)
    {
        <div class="side-panel-header">
            <h5>
                @_event.Title
                @if (_isTechMeeting)
                {
                    <span class="badge bg-success ms-2" style="font-size: 0.6em; vertical-align: middle;">Tech Meeting</span>
                }
                else if (_isWorkshop)
                {
                    <span class="badge bg-info ms-2" style="font-size: 0.6em; vertical-align: middle;">Workshop</span>
                }
            </h5>
            <button class="btn-panel-close" @onclick="Close">&times;</button>
        </div>
        <div class="side-panel-body">
            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <div class="alert @(_isError ? "alert-danger" : "alert-success") py-2 small">@_statusMessage</div>
            }

            <div class="mb-3" style="color: var(--text-muted); font-size: 0.85rem;">
                @if (_isWorkshop && _event.CoOwners.Any())
                {
                    <span>run by @string.Join(", ", new[] { _event.Owner?.DisplayName ?? "" }
                        .Concat(_event.CoOwners.Select(o => o.User.DisplayName)))</span>
                }
                else
                {
                    <span>by @_event.Owner?.DisplayName</span>
                }
            </div>

            @if (!string.IsNullOrEmpty(_event.Description))
            {
                <p style="color: var(--text-secondary);">@_event.Description</p>
            }

            <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span style="color: var(--text-muted);">Time</span>
                    <span>@_event.StartTime.ToString("MMM dd, yyyy h:mm tt", null) - @_event.EndTime.ToString("h:mm tt", null)</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span style="color: var(--text-muted);">Timezone</span>
                    <span>@_event.TimeZoneId</span>
                </div>
                @if (!_isTechMeeting || _isLightningTalks)
                {
                    <div class="d-flex justify-content-between mb-1">
                        <span style="color: var(--text-muted);">Capacity</span>
                        <span>@_effectiveCapacity per session</span>
                    </div>
                }
                @if (_event.Recurrence is not null)
                {
                    <div class="d-flex justify-content-between mb-1">
                        <span style="color: var(--text-muted);">Recurrence</span>
                        <span>@_event.Recurrence.Type (every @_event.Recurrence.Interval)</span>
                    </div>
                }
            </div>

            @if (_selectedOccurrence is not null)
            {
                <div class="card mb-3">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong>This Session</strong>
                            @if (_selectedOccurrence.IsCancelled)
                            {
                                <span class="badge" style="background-color: var(--accent-danger);">Cancelled</span>
                            }
                            else if (_isTechMeeting && !_isLightningTalks)
                            {
                                <span class="badge" style="background-color: var(--accent-success);">
                                    @_selectedOccurrence.Contributors.Count contributor@(_selectedOccurrence.Contributors.Count != 1 ? "s" : "")
                                </span>
                            }
                            else
                            {
                                var cap = _effectiveCapacity;
                                <span class="badge" style="background-color: var(--accent-success);">
                                    @_selectedOccurrence.Signups.Count / @cap signed up
                                </span>
                            }
                        </div>
                        <div style="color: var(--text-secondary); font-size: 0.9rem;">
                            @_selectedOccurrence.StartTime.ToString("ddd, MMM dd h:mm tt", null)
                        </div>

                        @* Topic display for regular tech meetings *@
                        @if (_isTechMeeting && !_isLightningTalks && !_selectedOccurrence.IsCancelled)
                        {
                            @if (!string.IsNullOrEmpty(_selectedOccurrence.NameSuffix))
                            {
                                <div class="mt-1" style="color: var(--text-secondary); font-style: italic;">
                                    "@_selectedOccurrence.DisplayName"
                                </div>
                            }
                            else
                            {
                                <div class="mt-1" style="color: var(--text-muted); font-size: 0.85rem;">No topic set</div>
                            }
                        }

                        @if (!_selectedOccurrence.IsCancelled)
                        {
                            <div class="mt-2">
                                @* Lightning talks toggle (owner only, tech meetings only) *@
                                @if (_isTechMeeting && _isOwner)
                                {
                                    <button class="btn btn-sm @(_isLightningTalks ? "btn-info" : "btn-outline-info") me-1"
                                            data-testid="sidebar-lightning-toggle"
                                            @onclick="ToggleLightningTalks">
                                        @(_isLightningTalks ? "⚡ Talks On" : "⚡ Talks Off")
                                    </button>

                                    @if (_isLightningTalks)
                                    {
                                        <div class="d-inline-flex align-items-center gap-1 ms-1">
                                            <label class="form-label mb-0 small">Slots:</label>
                                            <input type="number" class="form-control form-control-sm" style="width:70px;"
                                                   min="1"
                                                   value="@_effectiveCapacity"
                                                   @onchange="UpdateLightningTalksCapacity" />
                                        </div>
                                    }
                                }

                                @if (_isTechMeeting && !_isLightningTalks)
                                {
                                    @* Regular tech meeting: name editing + contributors, no signup *@

                                    @* Name editing *@
                                    @if (_isOwner || _isContributor)
                                    {
                                        <div class="mt-2">
                                            <label class="form-label small mb-1" style="color: var(--text-muted);">Topic</label>
                                            <div class="d-flex gap-1">
                                                <input type="text" class="form-control form-control-sm"
                                                       data-testid="sidebar-name-suffix"
                                                       placeholder="Set topic..."
                                                       @bind="_nameSuffix" @bind:event="oninput" />
                                                <button class="btn btn-sm btn-outline-primary"
                                                        @onclick="SaveOccurrenceName"
                                                        disabled="@_actionInProgress">Save</button>
                                            </div>
                                        </div>
                                    }

                                    @* Contributor list *@
                                    <div class="mt-2">
                                        <label class="form-label small mb-1" style="color: var(--text-muted);">Contributors</label>
                                        @if (_selectedOccurrence.Contributors.Any())
                                        {
                                            @foreach (var c in _selectedOccurrence.Contributors)
                                            {
                                                <div class="d-flex justify-content-between align-items-center py-1" style="border-bottom: 1px solid var(--border-color); font-size: 0.85rem;">
                                                    <span>@c.User?.DisplayName</span>
                                                    @if (_isOwner)
                                                    {
                                                        <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size:0.7rem;"
                                                                @onclick="() => RemoveContributor(c.UserId)">×</button>
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div style="color: var(--text-muted); font-size: 0.85rem;">No contributors assigned</div>
                                        }

                                        @if (_isOwner)
                                        {
                                            <div class="d-flex gap-1 align-items-center mt-1" data-testid="sidebar-add-contributor">
                                                <UserTypeahead @bind-SelectedUser="_contributorSelection"
                                                               Placeholder="Add contributor..." />
                                                <button class="btn btn-sm btn-outline-primary"
                                                        disabled="@(_contributorSelection is null)"
                                                        @onclick="AddContributor">Add</button>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @* Office hours or lightning talks: signup UI *@
                                    @if (_isSignedUp)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="CancelSignup" disabled="@_actionInProgress">
                                            Cancel Signup
                                        </button>
                                    }
                                    else if (_selectedOccurrence.Signups.Count < _effectiveCapacity)
                                    {
                                        <div class="mb-2">
                                            <input type="text" class="form-control form-control-sm" placeholder="Topic to discuss (required)"
                                                   @bind="_signupMessage" @bind:event="oninput" />
                                        </div>
                                        <button class="btn btn-sm btn-primary" @onclick="SignUp"
                                                disabled="@(_actionInProgress || string.IsNullOrWhiteSpace(_signupMessage))">
                                            Sign Up
                                        </button>
                                    }
                                }

                                @if (_isOwner)
                                {
                                    <button class="btn btn-sm ms-1" style="color: var(--accent-danger); border-color: var(--accent-danger);"
                                            @onclick="CancelOccurrence" disabled="@_actionInProgress">
                                        Cancel Session
                                    </button>
                                }
                            </div>
                        }
                        else if (_isOwner)
                        {
                            <div class="mt-2">
                                <button class="btn btn-sm btn-outline-success"
                                        @onclick="UncancelOccurrence" disabled="@_actionInProgress">
                                    Restore Session
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Signups section — only for office hours or lightning talks *@
            @if (_selectedOccurrence is not null && (!_isTechMeeting || _isLightningTalks) && _selectedOccurrence.Signups.Any())
            {
                <div class="mb-3">
                    <strong style="font-size: 0.85rem; color: var(--text-muted);">Signups</strong>
                    @foreach (var signup in _selectedOccurrence.Signups)
                    {
                        <div class="d-flex justify-content-between align-items-start py-1" style="border-bottom: 1px solid var(--border-color); font-size: 0.85rem;">
                            <div>
                                <span>@signup.User?.DisplayName</span>
                                @if (_isOwner && !string.IsNullOrEmpty(signup.Message))
                                {
                                    <div style="color: var(--text-muted); font-size: 0.8rem; font-style: italic;">"@signup.Message"</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="d-flex gap-2 flex-wrap">
                <a href="events/@_event.Id" class="btn btn-sm btn-secondary">View Full Details</a>
                @if (_isOwner)
                {
                    <button class="btn btn-sm btn-secondary" @onclick="EditEvent">Edit</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="DeleteEvent" disabled="@_actionInProgress">Delete Event</button>
                }
            </div>
        </div>
    }
    else if (IsVisible)
    {
        <div class="side-panel-header">
            <h5>Loading...</h5>
            <button class="btn-panel-close" @onclick="Close">&times;</button>
        </div>
        <div class="side-panel-body">
            <div class="spinner-border spinner-border-sm"></div>
        </div>
    }
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public int? EventId { get; set; }
    [Parameter] public int? OccurrenceId { get; set; }
    [Parameter] public EventCallback OnEventChanged { get; set; }
    [Parameter] public EventCallback<int> OnEditRequested { get; set; }

    private Event? _event;
    private EventOccurrence? _selectedOccurrence;
    // _isOwner means "may manage this event": the creator or any co-owner.
    private bool _isOwner;
    private bool _isSignedUp;
    private bool _isTechMeeting;
    private bool _isWorkshop;
    private bool _isLightningTalks;
    private bool _isContributor;
    private int _effectiveCapacity;
    private int _currentUserId;
    private string? _statusMessage;
    private bool _isError;
    private bool _actionInProgress;
    private int? _lastEventId;
    private int? _lastOccurrenceId;
    private string? _signupMessage;
    private string? _nameSuffix;
    private UserSearchResult? _contributorSelection;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && EventId.HasValue && (EventId != _lastEventId || OccurrenceId != _lastOccurrenceId))
        {
            _lastEventId = EventId;
            _lastOccurrenceId = OccurrenceId;
            _statusMessage = null;
            await LoadEvent();
        }
        else if (!IsVisible)
        {
            _lastEventId = null;
            _lastOccurrenceId = null;
        }
    }

    private async Task LoadEvent()
    {
        if (!EventId.HasValue) return;

        _event = await EventService.GetEventAsync(EventId.Value);
        if (_event is null) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim is not null && int.TryParse(userIdClaim.Value, out var uid))
        {
            _currentUserId = uid;
            _isOwner = _event.OwnerUserId == uid
                || _event.CoOwners.Any(o => o.UserId == uid);
        }

        _isTechMeeting = _event.EventType == EventType.TechMeeting;
        _isWorkshop = _event.EventType == EventType.Workshop;

        if (OccurrenceId.HasValue)
        {
            _selectedOccurrence = _event.Occurrences.FirstOrDefault(o => o.Id == OccurrenceId.Value);
        }

        if (_selectedOccurrence is null)
        {
            var now = SystemClock.Instance.GetCurrentInstant();
            var zone = Services.TimeZoneHelper.GetZone(_event.TimeZoneId);
            var nowLocal = now.InZone(zone).LocalDateTime;

            _selectedOccurrence = _event.Occurrences
                .Where(o => o.StartTime.CompareTo(nowLocal) >= 0)
                .OrderBy(o => o.StartTime)
                .FirstOrDefault();
        }

        if (_selectedOccurrence is not null)
        {
            _isSignedUp = _selectedOccurrence.Signups.Any(s => s.UserId == _currentUserId);
            _isLightningTalks = _selectedOccurrence.IsLightningTalks;
            _isContributor = _selectedOccurrence.Contributors.Any(c => c.UserId == _currentUserId);
            _effectiveCapacity = _selectedOccurrence.LightningTalksCapacity ?? _event.Capacity;
            _nameSuffix = _selectedOccurrence.NameSuffix ?? "";
        }
    }

    private async Task SignUp()
    {
        if (_selectedOccurrence is null || _event is null) return;
        _actionInProgress = true;
        _statusMessage = null;

        var (success, error) = await EventService.SignUpAsync(_selectedOccurrence.Id, _currentUserId, _signupMessage!);
        if (success)
        {
            _statusMessage = "Signed up!";
            _isError = false;
            _signupMessage = null;
            await LoadEvent();
            await OnEventChanged.InvokeAsync();
        }
        else
        {
            _statusMessage = error;
            _isError = true;
        }
        _actionInProgress = false;
    }

    private async Task CancelSignup()
    {
        if (_selectedOccurrence is null || _event is null) return;
        _actionInProgress = true;
        _statusMessage = null;

        var (success, error) = await EventService.CancelSignUpAsync(_selectedOccurrence.Id, _currentUserId);
        if (success)
        {
            _statusMessage = "Signup cancelled.";
            _isError = false;
            await LoadEvent();
            await OnEventChanged.InvokeAsync();
        }
        else
        {
            _statusMessage = error;
            _isError = true;
        }
        _actionInProgress = false;
    }

    private async Task CancelOccurrence()
    {
        if (_selectedOccurrence is null) return;
        _actionInProgress = true;
        _statusMessage = null;

        var (success, error) = await EventService.CancelOccurrenceAsync(_selectedOccurrence.Id, _currentUserId);
        if (success)
        {
            _statusMessage = "Session cancelled.";
            _isError = false;
            await LoadEvent();
            await OnEventChanged.InvokeAsync();
        }
        else
        {
            _statusMessage = error;
            _isError = true;
        }
        _actionInProgress = false;
    }

    private async Task UncancelOccurrence()
    {
        if (_selectedOccurrence is null) return;
        _actionInProgress = true;
        _statusMessage = null;

        var (success, error) = await EventService.UncancelOccurrenceAsync(_selectedOccurrence.Id, _currentUserId);
        if (success)
        {
            _statusMessage = "Session restored.";
            _isError = false;
            await LoadEvent();
            await OnEventChanged.InvokeAsync();
        }
        else
        {
            _statusMessage = error;
            _isError = true;
        }
        _actionInProgress = false;
    }

    private async Task ToggleLightningTalks()
    {
        if (_selectedOccurrence is null) return;
        _actionInProgress = true;
        _statusMessage = null;

        var newState = !_isLightningTalks;
        var (success, error) = await EventService.ToggleLightningTalksAsync(_selectedOccurrence.Id, _currentUserId, newState);
        if (success)
        {
            _statusMessage = newState ? "Lightning talks enabled." : "Lightning talks disabled.";
            _isError = false;
            await LoadEvent();
            await OnEventChanged.InvokeAsync();
        }
        else
        {
            _statusMessage = error;
            _isError = true;
        }
        _actionInProgress = false;
    }

    private async Task UpdateLightningTalksCapacity(ChangeEventArgs e)
    {
        if (_selectedOccurrence is null) return;
        if (!int.TryParse(e.Value?.ToString(), out var capacity) || capacity < 1) return;

        var (success, error) = await EventService.ToggleLightningTalksAsync(_selectedOccurrence.Id, _currentUserId, true, capacity);
        if (!success)
        {
            _statusMessage = error;
            _isError = true;
        }
        await LoadEvent();
        await OnEventChanged.InvokeAsync();
    }

    private async Task SaveOccurrenceName()
    {
        if (_selectedOccurrence is null) return;
        _actionInProgress = true;

        var (success, error) = await EventService.UpdateOccurrenceNameAsync(
            _selectedOccurrence.Id, _currentUserId, null, _nameSuffix ?? "");
        if (success)
        {
            _statusMessage = "Topic saved.";
            _isError = false;
            await LoadEvent();
            await OnEventChanged.InvokeAsync();
        }
        else
        {
            _statusMessage = error;
            _isError = true;
        }
        _actionInProgress = false;
    }

    private async Task AddContributor()
    {
        if (_selectedOccurrence is null || _contributorSelection is null) return;
        _actionInProgress = true;

        var targetUserId = _contributorSelection.Id;
        if (_contributorSelection.IsAdOnly)
        {
            var ensured = await UserSearchService.EnsureUserAsync(_contributorSelection.Username);
            if (ensured is null)
            {
                _statusMessage = "Could not create local account for the selected AD user.";
                _isError = true;
                _actionInProgress = false;
                return;
            }
            targetUserId = ensured.Id;
        }

        var existingIds = _selectedOccurrence.Contributors.Select(c => c.UserId).ToList();
        existingIds.Add(targetUserId);

        var (success, error) = await EventService.SetContributorsAsync(_selectedOccurrence.Id, _currentUserId, existingIds);
        if (success)
        {
            _statusMessage = $"Added {_contributorSelection.DisplayName} as contributor.";
            _isError = false;
            _contributorSelection = null;
            await LoadEvent();
            await OnEventChanged.InvokeAsync();
        }
        else
        {
            _statusMessage = error;
            _isError = true;
        }
        _actionInProgress = false;
    }

    private async Task RemoveContributor(int userId)
    {
        if (_selectedOccurrence is null) return;
        _actionInProgress = true;

        var remainingIds = _selectedOccurrence.Contributors
            .Where(c => c.UserId != userId)
            .Select(c => c.UserId)
            .ToList();

        var (success, error) = await EventService.SetContributorsAsync(_selectedOccurrence.Id, _currentUserId, remainingIds);
        if (success)
        {
            _statusMessage = "Contributor removed.";
            _isError = false;
            await LoadEvent();
            await OnEventChanged.InvokeAsync();
        }
        else
        {
            _statusMessage = error;
            _isError = true;
        }
        _actionInProgress = false;
    }

    private async Task EditEvent()
    {
        if (_event is not null)
        {
            await OnEditRequested.InvokeAsync(_event.Id);
        }
    }

    private async Task DeleteEvent()
    {
        if (_event is null) return;
        _actionInProgress = true;
        _statusMessage = null;

        var (success, error) = await EventService.DeleteEventAsync(_event.Id, _currentUserId);
        if (success)
        {
            await OnEventChanged.InvokeAsync();
            await Close();
        }
        else
        {
            _statusMessage = error;
            _isError = true;
        }
        _actionInProgress = false;
    }

    private async Task Close()
    {
        IsVisible = false;
        _event = null;
        _lastEventId = null;
        await IsVisibleChanged.InvokeAsync(false);
    }
}
