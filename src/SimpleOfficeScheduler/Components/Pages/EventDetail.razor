@page "/events/{EventId:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using NodaTime
@using SimpleOfficeScheduler.Services
@inject IEventService EventService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IClock Clock
@inject IUserSearchService UserSearchService
@rendermode InteractiveServer

<PageTitle>Event Details - Office Scheduler</PageTitle>

@if (_event is null)
{
    <div class="d-flex align-items-center gap-2 py-4">
        <span class="spinner-border spinner-border-sm text-primary"></span>
        <span class="text-muted">Loading event details...</span>
    </div>
    return;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3>
            @_event.Title
            @if (_event.EventType == EventType.TechMeeting)
            {
                <span class="badge bg-success ms-2" data-testid="event-type-badge" style="font-size: 0.6em; vertical-align: middle;">Tech Meeting</span>
            }
        </h3>
        <p class="text-muted">Owned by @_event.Owner.DisplayName</p>
    </div>
    @if (_isOwner)
    {
        <div>
            <a href="events/@EventId/edit" class="btn btn-outline-secondary btn-sm me-1">Edit</a>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(_event.Description))
{
    <p>@_event.Description</p>
}

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_messageIsError ? "alert-danger" : "alert-success")">@_message</div>
}

<div class="row mb-3">
    <div class="col-md-3"><strong>Capacity:</strong> @_event.Capacity per session</div>
    <div class="col-md-3">
        <strong>Type:</strong>
        @if (_event.Recurrence is not null)
        {
            <span>@_event.Recurrence.Type (every @_event.Recurrence.Interval)</span>
        }
        else
        {
            <span>One-time</span>
        }
    </div>
    <div class="col-md-3">
        <strong>Timezone:</strong> @_event.TimeZoneId
    </div>
    @if (!string.IsNullOrEmpty(_event.RoomDisplayName))
    {
        <div class="col-md-3">
            <strong>Room:</strong> @_event.RoomDisplayName
        </div>
    }
</div>

@{
    var roomProblems = _event.Occurrences
        .Where(o => !o.IsCancelled
            && o.RoomBookingStatus is RoomBookingStatus.Declined or RoomBookingStatus.Failed)
        .OrderBy(o => o.StartTime)
        .ToList();
}
@if (roomProblems.Count > 0)
{
    <div class="alert alert-warning">
        <strong>@_event.RoomDisplayName could not be booked for @roomProblems.Count
            @(roomProblems.Count == 1 ? "date" : "dates").</strong>
        <ul class="mb-2 mt-1">
            @foreach (var occ in roomProblems.Take(10))
            {
                <li>
                    @occ.StartTime.ToDateTimeUnspecified().ToString("ddd, MMM dd yyyy h:mm tt")
                    @if (!string.IsNullOrEmpty(occ.RoomBookingError))
                    {
                        <span class="text-muted"> — @occ.RoomBookingError</span>
                    }
                </li>
            }
        </ul>
        @if (roomProblems.Count > 10)
        {
            <div class="text-muted small mb-2">and @(roomProblems.Count - 10) more.</div>
        }
        @if (_isOwner)
        {
            <a class="btn btn-sm btn-outline-warning" href="events/@_event.Id/edit">Pick another room</a>
        }
    </div>
}

@if (_isWorkshop)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Owning Team</h5>
            <div class="d-flex flex-wrap gap-1 mb-2">
                <span class="badge bg-primary">@_event.Owner.DisplayName (creator)</span>
                @foreach (var co in _event.CoOwners)
                {
                    <span class="badge bg-secondary d-flex align-items-center gap-1">
                        @co.User.DisplayName
                        @if (_isOwner)
                        {
                            <button type="button" class="btn-close btn-close-white" style="font-size:0.55rem;"
                                    @onclick="() => RemoveCoOwner(co.UserId)"></button>
                        }
                    </span>
                }
            </div>
            @if (_isOwner)
            {
                <div class="d-flex gap-1 align-items-center">
                    <UserTypeahead SelectedUser="@_coOwnerSelection"
                                   SelectedUserChanged="@(u => _coOwnerSelection = u)"
                                   ExcludeUserId="_event.OwnerUserId"
                                   Placeholder="Add a co-owner..." />
                    <button class="btn btn-sm btn-outline-primary"
                            disabled="@(_coOwnerSelection is null)"
                            @onclick="AddCoOwner">Add</button>
                </div>
                <small class="text-muted d-block mt-1">
                    Co-owners can edit this workshop and are attendees on every occurrence.
                </small>
            }
        </div>
    </div>
}

@if (_isCreator)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Transfer Ownership</h5>
            <div class="mb-2">
                <UserTypeahead @bind-SelectedUser="_selectedTransferUser"
                               ExcludeUserId="_currentUserId"
                               Placeholder="Search by name, username, or email..." />
            </div>
            <button class="btn btn-outline-warning"
                    @onclick="TransferOwnership"
                    disabled="@(_selectedTransferUser is null)">
                @if (_selectedTransferUser is not null)
                {
                    <span>Transfer to @_selectedTransferUser.DisplayName</span>
                }
                else
                {
                    <span>Transfer</span>
                }
            </button>
        </div>
    </div>
}

@if (_isTechMeeting && _isOwner)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Reminders</h5>
            <div class="d-flex flex-wrap gap-1 mb-2">
                @foreach (var def in (_event.ReminderDefinitions?.OrderBy(d => d.DisplayOrder) ?? Enumerable.Empty<EventReminderDefinition>()))
                {
                    <span class="badge bg-secondary">
                        @def.Name
                        <button type="button" class="btn-close btn-close-white ms-1" style="font-size:0.5em;"
                                @onclick="() => RemoveReminder(def.Name)"></button>
                    </span>
                }
            </div>
            <div class="d-flex gap-1 align-items-center">
                <input type="text" class="form-control form-control-sm" style="max-width: 200px;"
                       placeholder="New reminder name..."
                       @bind="_newReminderName" @bind:event="oninput" />
                <button class="btn btn-sm btn-outline-primary"
                        disabled="@(string.IsNullOrWhiteSpace(_newReminderName))"
                        @onclick="AddReminder">Add</button>
            </div>
            @if (_event.ReminderDefinitions?.Count >= 10)
            {
                <small class="text-muted">Maximum 10 reminders reached.</small>
            }
        </div>
    </div>
}

<h4>Upcoming Occurrences</h4>

@{
    var zone = TimeZoneHelper.GetZone(_event.TimeZoneId);
    var nowInTz = Clock.GetCurrentInstant().InZone(zone).LocalDateTime;
    var upcomingOccurrences = _event.Occurrences
        .Where(o => o.StartTime.CompareTo(nowInTz.PlusHours(-1)) > 0)
        .OrderBy(o => o.StartTime)
        .Take(20)
        .ToList();
    var pastOccurrences = _event.Occurrences
        .Where(o => o.StartTime.CompareTo(nowInTz.PlusHours(-1)) <= 0)
        .OrderByDescending(o => o.StartTime)
        .ToList();
}

@if (!upcomingOccurrences.Any())
{
    <p>No upcoming occurrences.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Date & Time</th>
                    <th>Status</th>
                    @if (_isTechMeeting)
                    {
                        <th>Contributors / Signups</th>
                    }
                    else
                    {
                        <th>Signups</th>
                    }
                    <th>Actions</th>
                    @if (_isTechMeeting)
                    {
                        @foreach (var def in (_event.ReminderDefinitions?.OrderBy(d => d.DisplayOrder) ?? Enumerable.Empty<EventReminderDefinition>()))
                        {
                            <th style="font-size: 0.85rem;">@def.Name</th>
                        }
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var occ in upcomingOccurrences)
                {
                    var signupCount = occ.Signups.Count;
                    var occCapacity = occ.LightningTalksCapacity ?? _event.Capacity;
                    var isFull = signupCount >= occCapacity;
                    var isSignedUp = occ.Signups.Any(s => s.UserId == _currentUserId);
                    var startDt = occ.StartTime.ToDateTimeUnspecified();
                    var endDt = occ.EndTime.ToDateTimeUnspecified();
                    var isLR = occ.IsLightningTalks;

                    <tr class="@(occ.IsCancelled ? "table-secondary" : "")">
                        <td>
                            @if ((_isTechMeeting || _isWorkshop) && !string.IsNullOrEmpty(occ.DisplayName) && occ.DisplayName != _event.Title)
                            {
                                <strong>@occ.DisplayName</strong><br />
                            }
                            @startDt.ToString("ddd, MMM dd yyyy h:mm tt")
                            - @endDt.ToString("h:mm tt")
                            @if (occ.RoomBookingStatus is RoomBookingStatus.Declined or RoomBookingStatus.Failed)
                            {
                                <span class="badge bg-warning ms-1"
                                      title="@occ.RoomBookingError">No room</span>
                            }
                            else if (occ.RoomBookingStatus == RoomBookingStatus.Pending)
                            {
                                <span class="badge bg-secondary ms-1">Room pending</span>
                            }
                        </td>
                        <td>
                            @if (occ.IsCancelled)
                            {
                                <span class="badge bg-danger">Cancelled</span>
                            }
                            else if (_isTechMeeting && isLR)
                            {
                                <span class="badge bg-info">Lightning Talks</span>
                                @if (isFull)
                                {
                                    <span class="badge bg-warning ms-1">Full</span>
                                }
                            }
                            else if (_isTechMeeting)
                            {
                                <span class="badge bg-success">Tech Meeting</span>
                            }
                            else if (isFull)
                            {
                                <span class="badge bg-warning">Full</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Open</span>
                            }
                        </td>
                        <td>
                            @if (_isTechMeeting && !isLR)
                            {
                                @* Regular tech meeting: show contributors *@
                                @if (occ.Contributors.Any())
                                {
                                    @foreach (var c in occ.Contributors)
                                    {
                                        <span class="badge bg-secondary me-1">
                                            @c.User.DisplayName
                                            @if (_isOwner)
                                            {
                                                <button type="button" class="btn-close btn-close-white ms-1" style="font-size:0.5em;"
                                                        @onclick="() => RemoveContributor(occ, c.UserId)"></button>
                                            }
                                        </span>
                                    }
                                }
                                else
                                {
                                    <small class="text-muted">No contributors assigned</small>
                                }
                                @if (_isOwner)
                                {
                                    var occId = occ.Id;
                                    <div class="d-flex gap-1 align-items-center mt-1">
                                        <UserTypeahead SelectedUser="@GetContribSelection(occId)"
                                                       SelectedUserChanged="@(u => SetContribSelection(occId, u))"
                                                       Placeholder="Add contributor..." />
                                        <button class="btn btn-sm btn-outline-primary"
                                                disabled="@(GetContribSelection(occId) is null)"
                                                @onclick="() => AddContributor(occ)">Add</button>
                                    </div>
                                }
                                @if (_isOwner || occ.Contributors.Any(c => c.UserId == _currentUserId))
                                {
                                    <div class="mt-1">
                                        <div class="d-flex gap-1 align-items-center">
                                            <input type="text" class="form-control form-control-sm" style="max-width: 200px;"
                                                   placeholder="Topic..."
                                                   value="@(occ.NameSuffix ?? "")"
                                                   @onchange="(e) => SaveNameSuffix(occ.Id, e.Value?.ToString())" />
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                @* Office hours, workshops, or lightning talks: show signups *@
                                var effectiveCap = occ.LightningTalksCapacity ?? _event.Capacity;
                                <span>@signupCount / @effectiveCap</span>
                                @if (occ.Signups.Any())
                                {
                                    <br />
                                    <small class="text-muted">
                                        @string.Join(", ", occ.Signups.Select(s => s.User.DisplayName))
                                    </small>
                                }
                                @if (_isWorkshop && _isOwner)
                                {
                                    <div class="d-flex gap-1 align-items-center mt-1">
                                        <input type="text" class="form-control form-control-sm" style="max-width: 200px;"
                                               placeholder="Topic..."
                                               value="@(occ.NameSuffix ?? "")"
                                               @onchange="(e) => SaveNameSuffix(occ.Id, e.Value?.ToString())" />
                                    </div>
                                }
                            }
                        </td>
                        <td>
                            @if (!occ.IsCancelled)
                            {
                                @if (_isTechMeeting && _isOwner)
                                {
                                    <button class="btn btn-sm @(isLR ? "btn-info" : "btn-outline-info") me-1"
                                            data-testid="lightning-talks-toggle"
                                            @onclick="() => ToggleLightningTalks(occ.Id, !isLR)">
                                        @(isLR ? "⚡ Talks On" : "⚡ Talks Off")
                                    </button>
                                    @if (isLR)
                                    {
                                        <div class="d-inline-flex align-items-center gap-1 ms-1">
                                            <label class="form-label mb-0 small">Slots:</label>
                                            <input type="number" class="form-control form-control-sm" style="width:70px;"
                                                   min="1"
                                                   value="@(occ.LightningTalksCapacity ?? _event.Capacity)"
                                                   @onchange="(e) => UpdateLightningTalksCapacity(occ.Id, e.Value?.ToString())" />
                                        </div>
                                    }
                                }

                                @if (_isTechMeeting && !isLR)
                                {
                                    @* Regular tech meeting: no signup, just owner cancel *@
                                }
                                else
                                {
                                    @* Office hours or lightning talks: show signup/cancel UI *@
                                    @if (isSignedUp)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => CancelSignUp(occ.Id)">Cancel Signup</button>
                                    }
                                    else if (!isFull)
                                    {
                                        <div class="d-flex gap-1 align-items-center mt-1">
                                            <input type="text" class="form-control form-control-sm" style="max-width: 200px;"
                                                   data-testid="signup-message"
                                                   placeholder="@(_isWorkshop ? "Note (optional)" : "Topic to discuss")"
                                                   value="@GetSignupMessage(occ.Id)"
                                                   @oninput="(e) => SetSignupMessage(occ.Id, e.Value?.ToString())" />
                                            <button class="btn btn-sm btn-primary"
                                                    data-testid="signup-btn"
                                                    disabled="@(string.IsNullOrWhiteSpace(GetSignupMessage(occ.Id)))"
                                                    @onclick="() => SignUp(occ.Id)">Sign Up</button>
                                        </div>
                                    }
                                }

                                @if (_isOwner)
                                {
                                    <button class="btn btn-sm btn-outline-secondary ms-1"
                                            @onclick="() => CancelOccurrence(occ.Id)">Cancel Session</button>
                                }
                            }
                            else if (_isOwner)
                            {
                                <button class="btn btn-sm btn-outline-success"
                                        @onclick="() => UncancelOccurrence(occ.Id)">Restore Session</button>
                            }
                        </td>
                        @if (_isTechMeeting)
                        {
                            @foreach (var def in (_event.ReminderDefinitions?.OrderBy(d => d.DisplayOrder) ?? Enumerable.Empty<EventReminderDefinition>()))
                            {
                                var reminderVal = GetReminderValue(occ, def.Id);
                                <td class="text-center">
                                    @if (_isOwner)
                                    {
                                        <input type="checkbox" class="form-check-input"
                                               checked="@reminderVal"
                                               @onchange="() => ToggleReminder(occ.Id, def.Id, !reminderVal)" />
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="form-check-input" checked="@reminderVal" disabled />
                                    }
                                </td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (pastOccurrences.Any())
{
    <div class="mt-4">
        <h4 style="cursor: pointer;" data-testid="past-occurrences-toggle" @onclick="() => _showPastOccurrences = !_showPastOccurrences">
            @(_showPastOccurrences ? "▾" : "▸") Past Occurrences (@pastOccurrences.Count)
        </h4>

        @if (_showPastOccurrences)
        {
            <div class="table-responsive" data-testid="past-occurrences-table">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Status</th>
                            @if (_isTechMeeting)
                            {
                                <th>Contributors / Signups</th>
                            }
                            else
                            {
                                <th>Signups</th>
                            }
                            @if (_isTechMeeting)
                            {
                                @foreach (var def in (_event.ReminderDefinitions?.OrderBy(d => d.DisplayOrder) ?? Enumerable.Empty<EventReminderDefinition>()))
                                {
                                    <th style="font-size: 0.85rem;">@def.Name</th>
                                }
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var occ in pastOccurrences)
                        {
                            var signupCount = occ.Signups.Count;
                            var occCapacity = occ.LightningTalksCapacity ?? _event.Capacity;
                            var startDt = occ.StartTime.ToDateTimeUnspecified();
                            var endDt = occ.EndTime.ToDateTimeUnspecified();
                            var isLR = occ.IsLightningTalks;

                            <tr class="@(occ.IsCancelled ? "table-secondary" : "")">
                                <td>
                                    @if ((_isTechMeeting || _isWorkshop) && !string.IsNullOrEmpty(occ.DisplayName) && occ.DisplayName != _event.Title)
                                    {
                                        <strong>@occ.DisplayName</strong><br />
                                    }
                                    @startDt.ToString("ddd, MMM dd yyyy h:mm tt")
                                    - @endDt.ToString("h:mm tt")
                                </td>
                                <td>
                                    @if (occ.IsCancelled)
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                    else if (_isTechMeeting && isLR)
                                    {
                                        <span class="badge bg-info">Lightning Talks</span>
                                    }
                                    else if (_isTechMeeting)
                                    {
                                        <span class="badge bg-success">Tech Meeting</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Completed</span>
                                    }
                                </td>
                                <td>
                                    @if (_isTechMeeting && !isLR)
                                    {
                                        @if (occ.Contributors.Any())
                                        {
                                            <small>@string.Join(", ", occ.Contributors.Select(c => c.User.DisplayName))</small>
                                        }
                                    }
                                    else
                                    {
                                        <span>@signupCount / @occCapacity</span>
                                        @if (occ.Signups.Any())
                                        {
                                            <br />
                                            <small class="text-muted">
                                                @string.Join(", ", occ.Signups.Select(s => s.User.DisplayName))
                                            </small>
                                        }
                                    }
                                </td>
                                @if (_isTechMeeting)
                                {
                                    @foreach (var def in (_event.ReminderDefinitions?.OrderBy(d => d.DisplayOrder) ?? Enumerable.Empty<EventReminderDefinition>()))
                                    {
                                        var reminderVal = GetReminderValue(occ, def.Id);
                                        <td class="text-center">
                                            @if (_isOwner)
                                            {
                                                <input type="checkbox" class="form-check-input"
                                                       checked="@reminderVal"
                                                       @onchange="() => ToggleReminder(occ.Id, def.Id, !reminderVal)" />
                                            }
                                            else
                                            {
                                                <input type="checkbox" class="form-check-input" checked="@reminderVal" disabled />
                                            }
                                        </td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public int EventId { get; set; }

    private Event? _event;
    private int _currentUserId;
    // _isOwner means "may manage this event": the creator or any co-owner. _isCreator is the
    // narrower check, used only where ownership itself is being reassigned.
    private bool _isOwner;
    private bool _isCreator;
    private bool _isTechMeeting;
    private bool _isWorkshop;
    private string? _message;
    private bool _messageIsError;
    private UserSearchResult? _selectedTransferUser;
    private UserSearchResult? _coOwnerSelection;
    private readonly Dictionary<int, UserSearchResult?> _contributorSelections = new();
    private readonly Dictionary<int, string> _signupMessages = new();
    private string? _newReminderName;
    private bool _showPastOccurrences;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var claim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (claim is not null)
            int.TryParse(claim.Value, out _currentUserId);

        await LoadEvent();
    }

    private async Task LoadEvent()
    {
        _event = await EventService.GetEventAsync(EventId);
        _isCreator = _event?.OwnerUserId == _currentUserId;
        _isOwner = _isCreator || (_event?.CoOwners.Any(o => o.UserId == _currentUserId) ?? false);
        _isTechMeeting = _event?.EventType == EventType.TechMeeting;
        _isWorkshop = _event?.EventType == EventType.Workshop;
    }

    private string? GetSignupMessage(int occurrenceId) =>
        _signupMessages.TryGetValue(occurrenceId, out var msg) ? msg : null;

    private void SetSignupMessage(int occurrenceId, string? value) =>
        _signupMessages[occurrenceId] = value ?? string.Empty;

    private async Task SignUp(int occurrenceId)
    {
        var message = GetSignupMessage(occurrenceId) ?? string.Empty;
        var (success, error) = await EventService.SignUpAsync(occurrenceId, _currentUserId, message);
        _message = success ? "Successfully signed up!" : error;
        _messageIsError = !success;
        if (success) _signupMessages.Remove(occurrenceId);
        await LoadEvent();
    }

    private async Task CancelSignUp(int occurrenceId)
    {
        var (success, error) = await EventService.CancelSignUpAsync(occurrenceId, _currentUserId);
        _message = success ? "Signup cancelled." : error;
        _messageIsError = !success;
        await LoadEvent();
    }

    private async Task CancelOccurrence(int occurrenceId)
    {
        var (success, error) = await EventService.CancelOccurrenceAsync(occurrenceId, _currentUserId);
        _message = success ? "Occurrence cancelled." : error;
        _messageIsError = !success;
        await LoadEvent();
    }

    private async Task UncancelOccurrence(int occurrenceId)
    {
        var (success, error) = await EventService.UncancelOccurrenceAsync(occurrenceId, _currentUserId);
        _message = success ? "Session restored." : error;
        _messageIsError = !success;
        await LoadEvent();
    }

    private async Task AddCoOwner()
    {
        if (_event is null || _coOwnerSelection is null) return;

        var targetUserId = _coOwnerSelection.Id;

        // AD-only users have no local record yet, and ownership needs a real user id.
        if (_coOwnerSelection.IsAdOnly)
        {
            var ensured = await UserSearchService.EnsureUserAsync(_coOwnerSelection.Username);
            if (ensured is null)
            {
                _message = "Could not create local account for the selected AD user.";
                _messageIsError = true;
                return;
            }
            targetUserId = ensured.Id;
        }

        var ids = _event.CoOwners.Select(o => o.UserId).ToList();
        if (!ids.Contains(targetUserId))
            ids.Add(targetUserId);

        await SaveCoOwners(ids, $"Added {_coOwnerSelection.DisplayName} as a co-owner.");
        _coOwnerSelection = null;
    }

    private async Task RemoveCoOwner(int userId)
    {
        if (_event is null) return;

        var ids = _event.CoOwners.Select(o => o.UserId).Where(id => id != userId).ToList();
        await SaveCoOwners(ids, "Co-owner removed.");
    }

    private async Task SaveCoOwners(List<int> userIds, string successMessage)
    {
        var (success, error) = await EventService.SetCoOwnersAsync(EventId, _currentUserId, userIds);
        _message = success ? successMessage : error;
        _messageIsError = !success;
        await LoadEvent();
    }

    private async Task TransferOwnership()
    {
        if (_selectedTransferUser is null) return;

        var targetUserId = _selectedTransferUser.Id;

        // If this is an AD-only user (not yet in local DB), create their local record first
        if (_selectedTransferUser.IsAdOnly)
        {
            var ensured = await UserSearchService.EnsureUserAsync(_selectedTransferUser.Username);
            if (ensured is null)
            {
                _message = "Could not create local account for the selected AD user.";
                _messageIsError = true;
                return;
            }
            targetUserId = ensured.Id;
        }

        var (success, error) = await EventService.TransferOwnershipAsync(EventId, _currentUserId, targetUserId);
        _message = success ? $"Ownership transferred to {_selectedTransferUser.DisplayName}." : error;
        _messageIsError = !success;
        if (success) _selectedTransferUser = null;
        await LoadEvent();
    }

    private async Task ToggleLightningTalks(int occurrenceId, bool isLightningTalks)
    {
        var (success, error) = await EventService.ToggleLightningTalksAsync(occurrenceId, _currentUserId, isLightningTalks);
        _message = success ? (isLightningTalks ? "Lightning talks enabled." : "Lightning talks disabled.") : error;
        _messageIsError = !success;
        await LoadEvent();
    }

    private async Task SaveNameSuffix(int occurrenceId, string? value)
    {
        var (success, error) = await EventService.UpdateOccurrenceNameAsync(occurrenceId, _currentUserId, null, value ?? "");
        if (!success)
        {
            _message = error;
            _messageIsError = true;
        }
        await LoadEvent();
    }

    private async Task UpdateLightningTalksCapacity(int occurrenceId, string? value)
    {
        if (!int.TryParse(value, out var capacity) || capacity < 1) return;
        var (success, error) = await EventService.ToggleLightningTalksAsync(occurrenceId, _currentUserId, true, capacity);
        if (!success)
        {
            _message = error;
            _messageIsError = true;
        }
        await LoadEvent();
    }

    private UserSearchResult? GetContribSelection(int occurrenceId) =>
        _contributorSelections.TryGetValue(occurrenceId, out var val) ? val : null;

    private void SetContribSelection(int occurrenceId, UserSearchResult? user) =>
        _contributorSelections[occurrenceId] = user;

    private async Task AddContributor(EventOccurrence occ)
    {
        var selection = GetContribSelection(occ.Id);
        if (selection is null) return;

        var targetUserId = selection.Id;
        if (selection.IsAdOnly)
        {
            var ensured = await UserSearchService.EnsureUserAsync(selection.Username);
            if (ensured is null)
            {
                _message = "Could not create local account for the selected AD user.";
                _messageIsError = true;
                return;
            }
            targetUserId = ensured.Id;
        }

        var existingIds = occ.Contributors.Select(c => c.UserId).ToList();
        existingIds.Add(targetUserId);

        var (success, error) = await EventService.SetContributorsAsync(occ.Id, _currentUserId, existingIds);
        _message = success ? $"Added {selection.DisplayName} as contributor." : error;
        _messageIsError = !success;
        _contributorSelections.Remove(occ.Id);
        await LoadEvent();
    }

    private async Task RemoveContributor(EventOccurrence occ, int userId)
    {
        var remainingIds = occ.Contributors.Where(c => c.UserId != userId).Select(c => c.UserId).ToList();
        var (success, error) = await EventService.SetContributorsAsync(occ.Id, _currentUserId, remainingIds);
        _message = success ? "Contributor removed." : error;
        _messageIsError = !success;
        await LoadEvent();
    }

    // ── Reminders ───────────────────────────────────────────────────

    private bool GetReminderValue(EventOccurrence occ, int definitionId) =>
        occ.ReminderValues?.Any(v => v.ReminderDefinitionId == definitionId && v.Value) ?? false;

    private async Task ToggleReminder(int occurrenceId, int definitionId, bool value)
    {
        var (success, error) = await EventService.SetReminderValueAsync(occurrenceId, _currentUserId, definitionId, value);
        if (!success)
        {
            _message = error;
            _messageIsError = true;
        }
        await LoadEvent();
    }

    private async Task AddReminder()
    {
        if (string.IsNullOrWhiteSpace(_newReminderName) || _event is null) return;

        var names = (_event.ReminderDefinitions?.OrderBy(d => d.DisplayOrder).Select(d => d.Name).ToList() ?? new());
        names.Add(_newReminderName.Trim());

        var (success, error) = await EventService.SetReminderDefinitionsAsync(_event.Id, _currentUserId, names);
        _message = success ? $"Reminder '{_newReminderName.Trim()}' added." : error;
        _messageIsError = !success;
        if (success) _newReminderName = null;
        await LoadEvent();
    }

    private async Task RemoveReminder(string name)
    {
        if (_event is null) return;

        var names = _event.ReminderDefinitions?
            .OrderBy(d => d.DisplayOrder)
            .Select(d => d.Name)
            .Where(n => !string.Equals(n, name, StringComparison.OrdinalIgnoreCase))
            .ToList() ?? new();

        var (success, error) = await EventService.SetReminderDefinitionsAsync(_event.Id, _currentUserId, names);
        _message = success ? $"Reminder '{name}' removed." : error;
        _messageIsError = !success;
        await LoadEvent();
    }
}
